# Copy to .env and fill in real values. Validated at boot by src/config/env.ts.

# --- Database (required) ---
# Neon pooler URL. Use the connection string from Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# Integration tests (optional — only for `npm run test:integration`)
# ---------------------------------------------------------------------------
# The DB-backed integration suite uses the SAME DATABASE_URL above. To run it,
# point DATABASE_URL at the local test database instead of the development one:
#
#   DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/accubook_test?schema=public"
#
#   npm run test:integration:setup    # create + migrate accubook_test
#   npm run test:integration          # run the suite
#
# Then switch DATABASE_URL back to the development database.
#
# The suite TRUNCATES every table, so it refuses to start unless DATABASE_URL
# names a LOCAL PostgreSQL database called exactly "accubook_test". Forgetting
# to switch is therefore a hard failure, not a wiped development database.
#
# `npm test` (unit tests) needs no database at all.

# --- NextAuth (required) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARS"
NEXTAUTH_SECRET="${AUTH_SECRET}"
# Public URL of the app — set to your Vercel domain in production.
NEXTAUTH_URL="http://localhost:3000"
# Tells NextAuth to trust the X-Forwarded-Host header (needed on Vercel).
AUTH_TRUST_HOST="true"

# --- Optional toggles ---
# Set to "true" to allow `npm run db:seed` against a NODE_ENV=production database.
# ALLOW_PROD_SEED="true"
# Demo-credentials card on the login page. It renders BY DEFAULT, showing
# the seeded super admin from prisma/seed.ts, so an evaluator can sign in
# unaided. Whatever it shows is published to every visitor of /login.
#
# Before this instance holds real client books: set NEXT_PUBLIC_DEMO to
# "false" to remove the card, or point the two below at a restricted demo
# account in a throwaway organization. All three are inlined at build time,
# so a redeploy is required after changing them.
# NEXT_PUBLIC_DEMO="false"
# NEXT_PUBLIC_DEMO_EMAIL="demo@example.com"
# NEXT_PUBLIC_DEMO_PASSWORD="the-demo-password"

# --- Email (optional) ---
# When both RESEND_API_KEY and EMAIL_FROM are set, approval-request
# emails fire on voucher/bill submission. Without them the email
# service is a no-op (logs the intended send at info level).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="noreply@yourdomain.example"
# Public URL of the app — used to build deep-links into emails.
# Falls back to NEXTAUTH_URL when unset.
# APP_URL="https://accubook.example.com"

# --- Cron service-account (optional) ---
# When set, /api/cron/check-overdue and /api/cron/run-recurring accept
# external schedulers (Vercel Cron, GitHub Actions) via:
#   Authorization: Bearer <CRON_SECRET>
# Must be at least 32 chars. Generate: openssl rand -base64 32
# CRON_SECRET="REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARS"

# --- Rate limiting (optional but strongly recommended for prod) ---
# Upstash Redis REST credentials. When BOTH are set, /api/auth/register
# and the NextAuth credentials flow rate-limit by IP and by email
# (10/IP/10min and 5/email/10min on login; 5/IP/10min on register).
# When unset the rate-limit helper no-ops with a one-time warning, so
# preview deploys aren't blocked on Upstash provisioning. Provision a
# free Upstash Redis at https://upstash.com/ before going to prod.
# UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_ME"

# --- Error tracking (optional but strongly recommended for prod) ---
# Sentry DSN. When set, server errors are forwarded to Sentry. When
# unset Sentry is not initialized — local dev needs no Sentry account.
# NEXT_PUBLIC_SENTRY_DSN is the browser-side DSN (typically same value).
# SENTRY_DSN="https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/PROJECT_ID"
# NEXT_PUBLIC_SENTRY_DSN="${SENTRY_DSN}"

# --- Document inbox: reading bills and invoices off scans and photos ---
# The free path (text-carrying PDFs, then Tesseract, then Groq's free vision
# model) needs no Anthropic account. ANTHROPIC_API_KEY is only for the paid
# escalation — a photo or scan that Groq still can't read.
#
# GROQ_API_KEY turns on free AI-vision reading for photos and scans (a scanned
# PDF with no text layer still needs Claude — Groq's API takes images, not
# PDFs). Get a free key at https://console.groq.com — no credit card, rate
# limited rather than metered.
# GROQ_API_KEY="gsk_..."
#
# Which Groq model reads a page. Check https://console.groq.com/docs/vision
# for the current vision-capable model id before relying on the default —
# Groq's model lineup changes faster than Anthropic's (the model this
# defaulted to originally, llama-4-scout, was deprecated within weeks).
# OCR_GROQ_MODEL="qwen/qwen3.6-27b"
#
# ANTHROPIC_API_KEY turns automatic reading on for the paid fallback. Without
# it (and without GROQ_API_KEY) the inbox still works: a document opens with
# the original beside an empty form to type into.
# ANTHROPIC_API_KEY="sk-ant-..."
#
# Which model reads a page. Cost per single-page bill at ~2,000 input +
# ~1,200 output tokens: claude-opus-5 ≈ $0.040, claude-sonnet-5 ≈ $0.024,
# claude-haiku-4-5 ≈ $0.008. Defaults to claude-opus-5.
# OCR_MODEL="claude-opus-5"
#
# auto   (default) free reading first (including Groq), paid only when still thin
# free   never spend — digital PDFs, Tesseract and Groq only; no Claude
# claude always use the paid engine, even for readable PDFs
# manual no automatic reading at all
# OCR_ENGINE="auto"
#
# Indicative USD→INR rate, used only to display extraction cost. Stored costs
# stay in USD so a rate change never rewrites history. Defaults to 88.
# USD_INR_RATE="88"
#
# Cloudflare R2 holds the original files in deployment. Unset in local dev,
# where files are written under ./.uploads instead. Create an R2 bucket and
# an API token (Account Home > R2 > Manage API Tokens) with read/write access
# to it.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="accubook-documents"
